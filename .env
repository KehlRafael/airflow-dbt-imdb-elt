# ==========================================
# Environment Configuration for Airflow ELT
# ==========================================
# IMPORTANT: If you change database credentials (WAREHOUSE_POSTGRES_* or AIRFLOW_POSTGRES_*),
# you must also update the following files to match:
#   - dbt/imdb_ratings/profiles.yml
#   - postgres/pgpass
#   - postgres/servers.json

# Airflow Configuration
AIRFLOW_UID=50000
AIRFLOW_PROJ_DIR="./airflow"

# Airflow Web UI Credentials
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# Airflow Metadata Database (Internal)
AIRFLOW_POSTGRES_USER=airflow
AIRFLOW_POSTGRES_PASSWORD=airflow
AIRFLOW_POSTGRES_DB=airflow

# Data Warehouse Database (pgduckdb_warehouse)
WAREHOUSE_POSTGRES_USER=postgres
WAREHOUSE_POSTGRES_PASSWORD=postgres
WAREHOUSE_POSTGRES_DB=dwh
WAREHOUSE_PORT=5432

# pgAdmin Configuration
PGADMIN_DEFAULT_EMAIL=admin@admin.com
PGADMIN_DEFAULT_PASSWORD=admin
